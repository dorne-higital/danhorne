# Resend API key — https://resend.com/api-keys
NUXT_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered
NUXT_CONTACT_EMAIL_TO=you@example.com

# Sender address. Must be onboarding@resend.dev until a sending domain
# is verified in Resend, e.g. "Your Name <hello@yoursite.com>"
NUXT_CONTACT_EMAIL_FROM=Your Name <onboarding@resend.dev>

# --- SEO --------------------------------------------------------------------

# Site's real deployed URL, no trailing slash. Public — used to build the
# absolute URLs robots.txt/sitemap.xml require.
NUXT_PUBLIC_SITE_URL=https://yoursite.com

# --- CMS (content-blocks) --------------------------------------------------

# Supabase project — Settings > API in the Supabase dashboard.
NUXT_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key — server-only, never expose this to the client. Used for
# all direct DB/Storage access (server/utils/supabase.ts) AND by @nuxtjs/supabase
# for admin-level auth operations (invite/ban users) — same key, same project.
NUXT_SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Self-serve checkout (Stripe) -------------------------------------------
# Two independent things a site can subscribe to at once — a storage tier and
# a plan tier — see server/utils/stripe.ts and the setup guide for how these
# Price IDs get created. All optional: leave any of them blank and that row
# in /admin/integrations just shows current status with no checkout option.

# Dashboard > Developers > API keys. Secret is server-only; publishable is
# safe to ship to the browser (kept for future Stripe.js use — the checkout
# flow itself only needs the secret key, since it redirects to a Stripe-
# hosted page rather than embedding Stripe Elements).
NUXT_STRIPE_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard > Developers > Webhooks > (your endpoint) > Signing secret.
NUXT_STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# One recurring monthly Price ID per storage tier (Dashboard > Product
# catalog, or create via the API — see the setup guide).
NUXT_STRIPE_PRICE_2GB=price_xxxxxxxxxxxxxxxxxxxxxxxx
NUXT_STRIPE_PRICE_10GB=price_xxxxxxxxxxxxxxxxxxxxxxxx
NUXT_STRIPE_PRICE_UNLIMITED=price_xxxxxxxxxxxxxxxxxxxxxxxx
# One recurring monthly Price ID per plan tier — see the plans & pricing doc
# for what each bundle includes.
NUXT_STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxxxxxxxxxxxxxx
NUXT_STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Error monitoring (Sentry) -----------------------------------------------
# Optional — errors just aren't reported anywhere if this is blank. A DSN is
# meant to be public (same trust level as the Stripe publishable key above).
# Several client sites can share one Sentry project (each event gets tagged
# with NUXT_PUBLIC_SITE_URL so they're distinguishable) — sentry.io > Settings
# > Projects > (your project) > Client Keys (DSN).
NUXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx

# --- Admin auth (Supabase Auth, via @nuxtjs/supabase) ----------------------
# These two are PUBLIC (safe to ship to the browser) — same Supabase project
# as above, different key. Settings > API > "anon" / "publishable" key.
NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
